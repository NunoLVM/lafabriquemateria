---
import ScrollCue from "./ScrollCue.astro";
import "../styles/pages/home-savoir-faire.css";
---

<section id="savoir-faire" class="section sf">
  <div class="container">
    <div class="sf-inner">
      <div class="sf-text">
        <h2 class="sf-lede">La Fabrique Materia</h2>
        <p class="sf-intro">
          valorise les rebuts industriels de cuir grâce à un savoir-faire artisanal, alliant conscience écologique et
          innovation. Acteur engagé en économie circulaire, elle développe des matériaux durables et ouvre des
          perspectives créatives pour relever les défis environnementaux de demain.
        </p>
      </div>

      <div class="sf-media">
        <article class="sf-card">
          <img
            class="sf-photo"
            src="/images/paravent.jpg"
            alt="Paravent – matière La Fabrique Materia"
            loading="lazy"
          />
        </article>
      </div>
    </div>
  </div>
</section>
