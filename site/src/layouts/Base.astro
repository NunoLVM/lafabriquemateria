---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/components/scroll-cue.css";
import CookieBanner from "../components/CookieBanner.astro";
const { title = "La Fabrique Materia", description = "" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
  </head>

  <body>
    <Header />
    <main id="contenu" class="container">
      <main class="container">
        <slot />
      </main>
      <!-- <CookieBanner /> -->
    </main>
    <Footer />

    <a class="scroll-cue fixed" href="/#savoir-faire" aria-label="Faire défiler">
      <img class="icon" src="/images/seta.svg" alt="" aria-hidden="true" width="22" height="22" />
    </a>
    <script src="/scripts/scroll-cue.js" type="module"></script>
  </body>
</html>
