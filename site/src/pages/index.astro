---
import Base from "../layouts/Base.astro";
import SectionHero from "../components/SectionHero.astro";
import SectionSavoirFaire from "../components/SectionSavoirFaire.astro";
import SectionAPropos from "../components/SectionAPropos.astro";
---

<Base title="Accueil — La Fabrique Materia">
  <!-- Accueil -->
  <SectionHero />
  <!-- Savoir-faire -->
  <SectionSavoirFaire />

  <!-- À propos -->
  <SectionAPropos />
  <!-- Contact -->
  <section id="contact" class="section" style="background:var(--color-green)">
    <div class="container">
      <h2 style="font-family:var(--font-secondary);margin:0 0 .5rem">Contact</h2>
      <p>Formulaire avancé entrera ici.</p>
    </div>
  </section>
</Base>
