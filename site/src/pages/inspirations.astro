---
import Base from "../layouts/Base.astro";
---

<Base title="Inspirations — La Fabrique materia" description="Motifs et textures tirés de la charte graphique.">
  <h2>Inspirations</h2>

  <div class="grid">
    <figure>
      <img src="/images/charte/granispher.webp" alt="Motif Granispher noir et blanc" loading="lazy" />
      <figcaption>Granispher</figcaption>
    </figure>

    <figure>
      <img src="/images/charte/biolines.webp" alt="Motif organique à lignes, noir et blanc" loading="lazy" />
      <figcaption>Motif organique</figcaption>
    </figure>

    <figure>
      <img src="/images/charte/broyat.webp" alt="Motif Broyat noir et blanc" loading="lazy" />
      <figcaption>Broyat</figcaption>
    </figure>

    <figure>
      <img src="/images/charte/cuir-texture.webp" alt="Texture évoquant le cuir, noir et blanc" loading="lazy" />
      <figcaption>Texture cuir</figcaption>
    </figure>
  </div>

  <style>
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    figure {
      margin: 0;
    }
    img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
    }
    figcaption {
      margin-top: 0.5rem;
      font-size: 0.9rem;
      color: #555;
    }
  </style>
</Base>
